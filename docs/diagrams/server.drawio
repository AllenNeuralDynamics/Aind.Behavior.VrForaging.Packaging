          <mxGeometry x="295" y="500" width="150" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r6d" value="a NAMED processor failed — this session is bad, not our code. The column you sort by." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;" vertex="1" parent="v1">
          <mxGeometry x="445" y="500" width="240" height="42" as="geometry" />

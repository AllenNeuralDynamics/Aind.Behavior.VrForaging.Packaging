          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5l" value="/work/{job}/in/{session_name}&lt;br&gt;(s3 + local only; mount copies nothing)" style="edgeLabel;html=1;align=center;fontSize=10;" parent="e5" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

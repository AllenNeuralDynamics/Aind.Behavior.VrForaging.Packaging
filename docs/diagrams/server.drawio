  <diagram id="packages" name="2 · Packages">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="p0" />
        <mxCell id="p1" parent="p0" />
        <mxCell id="ptitle" value="Two distributions, one repo (a uv workspace). The dependency runs ONE WAY." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="p1">
          <mxGeometry x="60" y="30" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="&lt;b&gt;aind-behavior-vr-foraging-server&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#B85450&quot;&gt;NEVER PUBLISHED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;server/&amp;nbsp; ·&amp;nbsp; classifier &quot;Private :: Do Not Upload&quot; makes an accidental publish FAIL, not succeed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="p1">
          <mxGeometry x="60" y="90" width="620" height="480" as="geometry" />
        </mxCell>
        <mxCell id="o_sidecar" value="&lt;b&gt;sidecar.py&lt;/b&gt;&amp;nbsp; output.metadata.json + SidecarRecorder&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;lives HERE because a record of how a RUN went is not a data product&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="150" width="570" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_process" value="&lt;b&gt;process.py&lt;/b&gt;&amp;nbsp; one session + its sidecar — what runs in the container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="212" width="570" height="34" as="geometry" />
        </mxCell>
        <mxCell id="o_ledger" value="&lt;b&gt;ledger.py&lt;/b&gt;&amp;nbsp; SQLite: claim/lease, retry by error_kind, rerun, tags, events&lt;br&gt;&lt;b&gt;models.py&lt;/b&gt;&amp;nbsp; Job · JobStatus · ErrorKind" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="258" width="570" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_io" value="&lt;b&gt;sources/&lt;/b&gt;&amp;nbsp; WHICH sessions exist — docdb · local&lt;br&gt;&lt;b&gt;stores/&lt;/b&gt;&amp;nbsp; HOW bytes move — input_mount · input_s3 · input_local · output_s3 · output_local&lt;br&gt;&lt;b&gt;staging.py&lt;/b&gt;&amp;nbsp; include/exclude rules, manifests, disk budget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="320" width="570" height="66" as="geometry" />
        </mxCell>
        <mxCell id="o_run" value="&lt;b&gt;runner.py&lt;/b&gt;&amp;nbsp; docker argv · log capture · the exit-code × sidecar verdict&lt;br&gt;&lt;b&gt;worker.py&lt;/b&gt;&amp;nbsp; the loop on page 1&lt;br&gt;&lt;b&gt;dashboard.py&lt;/b&gt;&amp;nbsp; one table&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;cli.py&lt;/b&gt;&amp;nbsp; vr-foraging-server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="398" width="570" height="66" as="geometry" />
        </mxCell>
        <mxCell id="o_deps" value="extra runtime deps: &lt;b&gt;boto3&lt;/b&gt; · &lt;b&gt;aind-data-access-api&lt;/b&gt; · &lt;b&gt;pyyaml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;none of which can leak into the published wheel&#39;s metadata — that is what a separate distribution buys over an extra&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;spacingLeft=8;fontSize=11;dashed=1;" vertex="1" parent="p1">
          <mxGeometry x="85" y="478" width="570" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pkg" value="&lt;b&gt;aind-behavior-vr-foraging-packaging&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#82B366&quot;&gt;PUBLISHED TO PyPI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;src/&amp;nbsp; ·&amp;nbsp; knows nothing about containers, ledgers, S3 or sidecars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="p1">
          <mxGeometry x="60" y="660" width="620" height="240" as="geometry" />
        </mxCell>
        <mxCell id="k_pipeline" value="&lt;b&gt;pipeline/session.py&lt;/b&gt;&amp;nbsp; create_processors · process_session&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;(+ on_output / on_error)&lt;/font&gt;&lt;br&gt;&lt;b&gt;pipeline/batch.py&lt;/b&gt;&amp;nbsp; process_sessions · aggregate&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;(+ include predicate)&lt;/font&gt;&lt;br&gt;&lt;b&gt;pipeline/cli.py&lt;/b&gt;&amp;nbsp; vr-foraging-packaging: session · batch · aggregate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="720" width="570" height="66" as="geometry" />
        </mxCell>
        <mxCell id="k_proc" value="&lt;b&gt;processing/&lt;/b&gt;&amp;nbsp; the 7 processors + 2 legacy variants&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;nwb_file/&lt;/b&gt;&amp;nbsp; NwbSession&lt;br&gt;&lt;b&gt;_base.py&lt;/b&gt;&amp;nbsp; AbstractProcessor&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;_provenance.py&lt;/b&gt;&amp;nbsp; PackagingProvenance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="85" y="798" width="570" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dep_ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="p1" source="orch" target="pkg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep_ok_l" value="&lt;b&gt;depends on&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;calls process_session, imports&lt;br&gt;SESSION_TABLE and PackagingProvenance&lt;/font&gt;" style="edgeLabel;html=1;align=left;fontSize=11;" vertex="1" connectable="0" parent="dep_ok">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint x="20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dep_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.9;exitY=0;entryX=0.9;entryY=1;strokeColor=#b85450;strokeWidth=3;dashed=1;endArrow=none;startArrow=none;" edge="1" parent="p1" source="pkg" target="orch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="780" />
              <mxPoint x="740" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dep_no_x" value="&lt;font color=&quot;#B85450&quot; style=&quot;font-size:28px&quot;&gt;&lt;b&gt;✕&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="p1">
          <mxGeometry x="720" y="540" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dep_no_l" value="&lt;b&gt;never&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;enforced by&lt;br&gt;tests/test_package_boundary.py,&lt;br&gt;which walks the AST of every&lt;br&gt;published module — function&lt;br&gt;bodies included, because that&lt;br&gt;is where a lazy import hides.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;size=12;fontSize=11;spacingLeft=6;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="775" y="470" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Why the sidecar had to move — and what replaced it&lt;/b&gt;&lt;br&gt;&lt;br&gt;It used to be a &lt;b&gt;write_sidecar&lt;/b&gt; flag on process_session, in the published&lt;br&gt;package. Moving the file format into server meant process_session&lt;br&gt;would have had to import back OUT of it — the one direction that is&lt;br&gt;forbidden.&lt;br&gt;&lt;br&gt;So process_session grew a generic pair instead:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;on_output(processor, frame, path)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;on_error(processor, exception)&lt;/b&gt;&lt;br&gt;&lt;br&gt;It knows nothing about JSON, files or containers. SidecarRecorder&lt;br&gt;subscribes to both and owns the whole record.&lt;br&gt;&lt;br&gt;Same move for &lt;b&gt;aggregate(include=…)&lt;/b&gt;: it cannot tell a complete session&lt;br&gt;from one abandoned partway through, so the caller that can, says so." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;size=16;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="p1">
          <mxGeometry x="775" y="90" width="330" height="340" as="geometry" />
        </mxCell>
        <mxCell id="reraise" value="&lt;b&gt;Recording is not tolerance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SidecarRecorder.on_error appends the failure&lt;br&gt;and then RE-RAISES. A failing processor still&lt;br&gt;propagates, the container still exits nonzero.&lt;br&gt;The sidecar only gains a name for the culprit.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;size=14;fontSize=11;spacingLeft=6;spacingTop=2;" vertex="1" parent="p1">
          <mxGeometry x="775" y="640" width="330" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="provenance" name="3 · Provenance and verdicts">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="v0" />
        <mxCell id="v1" parent="v0" />
        <mxCell id="vtitle" value="What pins what — the chain from a git tag to a row in the ledger" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="v1">
          <mxGeometry x="50" y="25" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;git tag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a release is published&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="50" y="90" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;setuptools_scm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a real version, not 0.1.dev1+…&lt;br&gt;(needs .git in the build context,&lt;br&gt;and git in the builder image)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="270" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;docker build&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;--build-arg GIT_COMMIT&lt;br&gt;→ ENV PROCESSOR_GIT_COMMIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="510" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;GHCR&lt;/b&gt;&amp;nbsp; @sha256:…&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the digest pins the WHOLE closure —&lt;br&gt;contraqctor, pynwb, numpy — not just our version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="750" y="85" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;config: processor.digest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;an operator pins it by hand. Never by tag —&lt;br&gt;allow_unpinned exists only for local dev, and is&lt;br&gt;recorded honestly as provenance=&quot;unpinned&quot;.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="750" y="205" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;docker run -e PROCESSOR_IMAGE_URI=…&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the digest is INJECTED, never self-discovered:&lt;br&gt;a container cannot read its own image id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="750" y="330" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;build_code_ref()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reads the env var. Absent → &quot;unpinned&quot;,&lt;br&gt;stated plainly rather than invented.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="750" y="445" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;output.metadata.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;code.container.digest · code.commit · code.version&lt;br&gt;versions.packaging / data_contract / dataset&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="750" y="560" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;classify verifies the digest matches&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the sidecar must report the image we launched.&lt;br&gt;A mismatch is error_kind=code, not a warning.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="750" y="675" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;ledger columns&lt;/b&gt;&amp;nbsp; image_digest · git_commit · packaging_version · data_contract_version · dataset_version&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;and job_key includes the code fingerprint, so a version bump re-queues every session automatically&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="v1">
          <mxGeometry x="620" y="790" width="550" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ve1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;" edge="1" parent="v1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;" edge="1" parent="v1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;" edge="1" parent="v1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;" edge="1" parent="v1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;" edge="1" parent="v1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;" edge="1" parent="v1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;" edge="1" parent="v1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;" edge="1" parent="v1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;" edge="1" parent="v1" source="c9" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt" value="&lt;b&gt;classify — exit code × sidecar → one verdict&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Both signals are needed and neither alone is enough. Because any failure propagates, a&lt;br&gt;broken session exits nonzero AND leaves a sidecar naming what broke: the exit code says&lt;br&gt;a failure happened, the sidecar says whether it happened to the DATA or to the RUN.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="v1">
          <mxGeometry x="50" y="205" width="660" height="450" as="geometry" />
        </mxCell>
        <mxCell id="th" value="exit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="v1">

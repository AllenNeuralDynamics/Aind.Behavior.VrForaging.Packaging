<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.0.6 Chrome/138.0.7204.100 Electron/37.2.3 Safari/537.36" version="28.0.6" pages="3">
  <diagram id="runtime" name="1 · Runtime">
    <mxGraphModel dx="1426" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;blue = server package (never published)&lt;br&gt;green = packaging package (published to PyPI)&lt;br&gt;grey = data at rest&lt;br&gt;orange = external system" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;size=14;fontSize=11;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="1290" y="880" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ext_docdb" value="DocDB&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;metadata_index / data_assets&lt;br&gt;read-only, never written back&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="140" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ext_raw" value="Raw sessions&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;S3 prefix or mounted NAS&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="330" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ext_out" value="Output store&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;s3://…/{release}/sessions/&lt;br&gt;or a local tree&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="740" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="host" value="HOST&amp;nbsp; ·&amp;nbsp; single-purpose box&amp;nbsp; ·&amp;nbsp; mounts /var/run/docker.sock (root-equivalent)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="60" width="720" height="900" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="&lt;b&gt;ingest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;acquisition-type query, then a bounded&lt;br&gt;legacy fallback. Runs on a timer inside&lt;br&gt;the worker, or by hand with --dry-run.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="290" y="120" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="&lt;b&gt;ledger&lt;/b&gt;&amp;nbsp; jobs.sqlite&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one row per&lt;br&gt;(session, release, code fingerprint)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="530" y="115" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;worker&lt;/b&gt;&amp;nbsp; ·&amp;nbsp; one job at a time&amp;nbsp; ·&amp;nbsp; run replicas for parallelism (the claim is atomic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="250" width="470" height="660" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · claim&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;atomic, lease-based. A dead worker&#39;s&lt;br&gt;lease expires and the job returns to pending.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="305" y="315" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · stage input&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;InputStore: mount (default, copies&lt;br&gt;nothing) · s3 (download) · local. Include/exclude rules + disk budget.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="305" y="390" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · docker run&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;runner.build_docker_args → subprocess.&lt;br&gt;Combined stdout+stderr captured to logs/{job_id}.log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="305" y="465" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 · classify&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;exit code × sidecar → one verdict.&lt;br&gt;See page 3. The worker never guesses from a log string.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="305" y="540" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 · publish&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;OutputStore. The sidecar is uploaded LAST, so&lt;br&gt;a half-published session never looks complete.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="305" y="615" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6 · record&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;status, timings, byte counts, warn_count,&lt;br&gt;failed_processors, image digest, all three versions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="305" y="690" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;i&gt;also, every loop:&lt;/i&gt;&amp;nbsp; reap expired leases&amp;nbsp; ·&amp;nbsp; heartbeat (disk free, running count)&amp;nbsp; ·&amp;nbsp; ingest on a timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;spacingLeft=8;fontSize=10;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="305" y="765" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;job_dir removed on the way out&lt;/b&gt;, pass or fail — a failed job must not leak disk over 4700 sessions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;spacingLeft=8;fontSize=10;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="305" y="825" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dash" value="&lt;b&gt;serve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one sortable table&lt;br&gt;+ each run&#39;s log.&lt;br&gt;127.0.0.1:8080,&lt;br&gt;no auth — never&lt;br&gt;publish on 0.0.0.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="785" y="260" width="165" height="140" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="&lt;b&gt;aggregate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a separate job kind,&lt;br&gt;not per-session work.&lt;br&gt;&lt;br&gt;Gated on a ledger&lt;br&gt;predicate (nothing in&lt;br&gt;flight), not a cron.&lt;br&gt;&lt;br&gt;Full rebuild, never an&lt;br&gt;incremental append.&lt;br&gt;&lt;br&gt;Skips any session whose&lt;br&gt;sidecar is not ok.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="785" y="430" width="165" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cbound" value="EPHEMERAL CONTAINER&amp;nbsp; ·&amp;nbsp; one per session&amp;nbsp; ·&amp;nbsp; --rm" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#9673A6;" parent="1" vertex="1">
          <mxGeometry x="1060" y="120" width="600" height="720" as="geometry" />
        </mxCell>
        <mxCell id="cnote" value="&lt;b&gt;--network=none&lt;/b&gt; · &lt;b&gt;--memory=8g&lt;/b&gt; · &lt;b&gt;--cpus=2&lt;/b&gt; · image pinned by &lt;b&gt;@sha256 digest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;It cannot reach S3 even by mistake. The memory cap is kernel-enforced, so one&lt;br&gt;pathological session is killed alone (exit 137 → error_kind=infra) instead of&lt;br&gt;taking the worker and every in-flight sibling with it.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;size=14;fontSize=11;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
          <mxGeometry x="1090" y="155" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ccmd" value="&lt;b&gt;vr-foraging-server process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;--input-dir /mnt/{session_name}&amp;nbsp; --output-dir /work/{job_id}/out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1090" y="265" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cload" value="load_dataset(input_dir)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;done here, not inside process_session, so a session that will not&lt;br&gt;open still produces a sidecar saying so&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1090" y="350" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cps" value="&lt;b&gt;process_session(...)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot;&gt;the published library does all the work&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;session · position_velocity · sites · licks · sniffing · software_events · events&lt;br&gt;&lt;br&gt;Any processor raising propagates. There is no partial session.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1090" y="435" width="540" height="95" as="geometry" />
        </mxCell>
        <mxCell id="crec" value="&lt;b&gt;SidecarRecorder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;subscribes to on_output&lt;br&gt;and on_error. Records,&lt;br&gt;then RE-RAISES.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1090" y="560" width="255" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cfiles" value="&lt;b&gt;*.parquet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;provenance promoted into&lt;br&gt;the parquet schema&lt;br&gt;(+ optional .nwb.zarr)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1375" y="560" width="255" height="85" as="geometry" />
        </mxCell>
        <mxCell id="csidecar" value="&lt;b&gt;output.metadata.json&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;written even when the session fails —&lt;br&gt;that is the point. Per-processor status, rows, warn counts, code + image digest.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1090" y="670" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cinv" value="&lt;b&gt;Why /mnt/{session_name} and not /mnt/session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;session_id in every table is the input directory&#39;s own NAME.&lt;br&gt;A generic mount point stamps every row with session_id=&quot;session&quot;&lt;br&gt;and raises nothing. This is why there is no --session-name flag.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;size=14;fontSize=11;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
          <mxGeometry x="1090" y="750" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vol" value="&lt;b&gt;named volume&amp;nbsp; vrf_work&amp;nbsp; →&amp;nbsp; /work&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A NAME, not a host path. The daemon resolves it, so the containerised worker&lt;br&gt;never has to know its own host-side path — which is the one thing that fails&lt;br&gt;silently: the processor would see an empty directory and exit 0.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="640" y="1000" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="volLifetime" value="&lt;b&gt;Lifetime of /work/{job_id} &amp;#8212; three owners, one per job state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Steady state holds &lt;b&gt;concurrent jobs &amp;#215; one session&lt;/b&gt;, not the campaign. process_job clears the directory&lt;br&gt;on ENTRY as well as in a finally, and the entry half is the load-bearing one: job_id is stable across&lt;br&gt;attempts, so an attempt killed mid-write left its wreckage at exactly the path the retry will use &amp;#8212; and&lt;br&gt;publish ships out/ wholesale while the sidecar is rewritten, so the orphan would reach the store inside a&lt;br&gt;session recorded as a clean success. Nothing can finally its way out of SIGKILL; entry-side cleanup is the&lt;br&gt;only ordering that survives one.&lt;br&gt;&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;running&lt;/b&gt; &amp;#8212; nobody. Another worker's live job; claim sets running before any mkdir, so no mtime guesswork is needed.&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;pending / retrying&lt;/b&gt; &amp;#8212; the next attempt's entry-side cleanup. Also closes the read-then-delete race a sweeper would open.&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;completed / failed / dead / skipped&lt;/b&gt; &amp;#8212; sweep_work_dir(), each tick beside reap_expired_leases. Terminal; nobody is coming back.&lt;br&gt;&lt;br&gt;The ledger decides, never the filesystem: workers share this volume, and a directory whose name is not a job id it&lt;br&gt;knows is reported and left alone. min_free_disk_bytes is checked BEFORE claiming &amp;#8212; a job claimed onto a full&lt;br&gt;volume dies on ENOSPC and burns one of max_attempts.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;size=14;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="1130" width="620" height="235" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;" parent="1" source="ext_docdb" target="ingest" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1l" value="discover since watermark" style="edgeLabel;html=1;align=center;fontSize=10;" parent="e1" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" parent="1" source="ingest" target="ledger" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" value="upsert by job_key&lt;br&gt;(idempotent)" style="edgeLabel;html=1;align=center;fontSize=10;" parent="e2" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">

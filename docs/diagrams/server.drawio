        </mxCell>
        <mxCell id="r7d" value="a contradiction. Believe the exit code — a session is not usable because a record says so." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;" vertex="1" parent="v1">
          <mxGeometry x="445" y="542" width="240" height="42" as="geometry" />

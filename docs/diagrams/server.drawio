        </mxCell>
        <mxCell id="r6b" value="status = error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;fontStyle=1" vertex="1" parent="v1">
          <mxGeometry x="165" y="500" width="130" height="42" as="geometry" />
        </mxCell>
